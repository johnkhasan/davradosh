NODE_ENV=development
PORT=4000
# Optional in development. Without it rooms live in memory only.
DATABASE_URL=postgresql://puzzle:puzzle@localhost:5432/puzzle
CORS_ORIGINS=http://localhost:3000
MAX_PLAYERS_PER_ROOM=5
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
UNSPLASH_ACCESS_KEY=
# Serve UPLOAD_DIR from the app. Defaults to true outside production (Caddy serves it there).
# SERVE_UPLOADS=true
