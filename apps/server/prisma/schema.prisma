generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  PLAYING
  COMPLETED
}

model Room {
  /// nanoid(8), used in the share link: /room/{id}
  id           String     @id
  /// 4-digit join code, unique among stored rooms; null when none was free
  code         String?    @unique
  /// clientId of the player who created the room
  hostId       String
  /// Public id of the current host when it moved away from the creator
  hostPlayerId String?
  imageId      String
  image        Image      @relation(fields: [imageId], references: [id])
  cols         Int
  rows         Int
  seed         Int
  rotation     Boolean    @default(false)
  /// 2..5, capped by MAX_PLAYERS_PER_ROOM on the server
  maxPlayers   Int        @default(5)
  status       RoomStatus @default(PLAYING)
  /// Snapshot of pieces and groups, written periodically by the game server
  state        Json?
  /// Per-player stats: merges made, pieces placed
  stats        Json?
  createdAt    DateTime   @default(now())
  /// Start of the current round (the host can restart the puzzle)
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  /// Public player ids the host kicked with a ban
  banned       String[]   @default([])
  expiresAt    DateTime

  @@index([expiresAt])
}

model Image {
  id        String   @id
  /// "upload" | "unsplash"
  source    String
  url       String
  thumbUrl  String
  width     Int
  height    Int
  /// Attribution text for gallery images
  credit    String?
  createdAt DateTime @default(now())
  rooms     Room[]
}

enum MafiaStatus {
  LOBBY
  PLAYING
}

/// A mafia room (see mafia-plan.md). `game` holds the roles: it never leaves the server.
model MafiaRoom {
  /// nanoid(8), used in the share link: /mafia/{id}
  id        String      @id
  /// 4-digit join code, shared with puzzle rooms; null when none was free
  code      String?     @unique
  /// Public player id of the current host
  hostId    String
  /// Players at the table: 6–12, 10 is the official game
  tableSize Int         @default(10)
  status    MafiaStatus @default(LOBBY)
  /// Room members (players and spectators) without socket data
  members   Json        @default("[]")
  /// MafiaGameSnapshot of the game in progress or just finished
  game      Json?
  /// Public player ids the host kicked with a ban
  banned    String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  expiresAt DateTime

  @@index([expiresAt])
}

enum TableStatus {
  LOBBY
  PLAYING
}

/// A room of one of the turn-based table games (chess, checkers, uno, battleship, puzzle race).
model TableRoom {
  /// nanoid(8), used in the share link: /{game path}/{id}
  id        String      @id
  /// "chess" | "checkers" | "uno" | "battleship" | "race"
  kind      String
  /// Public player id of the current host
  hostId    String
  /// Game options chosen at creation
  options   Json?
  status    TableStatus @default(LOBBY)
  /// Room members (players and spectators) without socket data
  members   Json        @default("[]")
  /// The game in progress or just finished, with hidden information: server only
  game      Json?
  /// Games started so far; rotates seats between rematches
  round     Int         @default(0)
  /// Public player ids the host kicked with a ban
  banned    String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  expiresAt DateTime

  @@index([expiresAt])
}

/// Best time of one player on one day's daily puzzle (/puzzle/kunlik).
model DailyResult {
  id        Int      @id @default(autoincrement())
  /// Tashkent date of the puzzle, "YYYY-MM-DD"
  day       String
  /// Public player id
  playerId  String
  name      String
  color     String
  avatar    String
  /// Solving time in milliseconds
  ms        Int
  createdAt DateTime @default(now())

  @@unique([day, playerId])
  @@index([day, ms])
}
