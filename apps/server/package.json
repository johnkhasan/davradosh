{
  "name": "@puzzle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@puzzle/shared": "workspace:*",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "lint": "prisma generate && tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  }
