# api.puzzle.javohir.ru → game server (REST + Socket.IO) and uploaded images.
# rtc.puzzle.javohir.ru → LiveKit signalling (voice/video).
# Caddy obtains and renews the Let's Encrypt certificate automatically.
{
	email {$ACME_EMAIL:admin@javohir.ru}
}

api.puzzle.javohir.ru {
	encode zstd gzip

	handle_path /uploads/* {
		root * /srv/uploads
		# File names are random ids and never change.
		header Cache-Control "public, max-age=31536000, immutable"
		# Pieces are drawn on a <canvas>, so images must be CORS-readable.
		header Access-Control-Allow-Origin "*"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		request_body {
			max_size 12MB
		}
		# WebSocket upgrades are proxied automatically.
		reverse_proxy 127.0.0.1:4000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

rtc.puzzle.javohir.ru {
	# LiveKit signalling (WebSocket) and API; media flows over UDP directly.
	reverse_proxy 127.0.0.1:7880

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
