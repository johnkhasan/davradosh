# Copy to /srv/puzzle/.env on the VPS and `chmod 600 .env`.
POSTGRES_USER=puzzle
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=puzzle

# Browser origins allowed to call the API. `*` matches one label (Vercel previews).
CORS_ORIGINS=https://davradosh.uz,https://davradosh-*-jvhrhsnvs-projects.vercel.app
MAX_PLAYERS_PER_ROOM=5
PUBLIC_UPLOAD_URL=https://api.puzzle.javohir.ru/uploads

# Optional: Unsplash gallery with categories (https://unsplash.com/developers).
UNSPLASH_ACCESS_KEY=

# Voice/video (LiveKit). Generate with: openssl rand -hex 32
LIVEKIT_URL=wss://rtc.puzzle.javohir.ru
LIVEKIT_API_KEY=puzzle
LIVEKIT_API_SECRET=change-me-to-64-random-hex-characters

# Image tag deployed by GitHub Actions (defaults to :latest).
# SERVER_IMAGE=ghcr.io/johnkhasan/puzzle-server:<sha>

# Docker network of the shared reverse proxy (nginx).
# PROXY_NETWORK=hsbch_default
